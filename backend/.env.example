# ===========================================
# MEDICOVA ENVIRONMENT CONFIGURATION TEMPLATE
# ===========================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to Git!

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Neon DB PostgreSQL connection string
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=postgresql://your_user:your_password@your_host.neon.tech/your_database?sslmode=require

# ===========================================
# AI/ML API KEYS
# ===========================================
# Google Gemini API Key (Required for AI features)
# Get your free key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# ===========================================
# SECURITY
# ===========================================
# Secret key for JWT token generation (use a strong random string)
SECRET_KEY=your_secret_key_here_minimum_32_characters

# ===========================================
# OPTIONAL: WHATSAPP BOT (Twilio)
# ===========================================
# Only required if deploying WhatsApp bot
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=whatsapp:+14155238886

# ===========================================
# OPTIONAL: DEPLOYMENT SETTINGS
# ===========================================
# ENVIRONMENT=production
# LOG_LEVEL=INFO
# CORS_ORIGINS=https://yourdomain.com

# ===========================================
# EVALUATOR NOTES
# ===========================================
# For testing purposes, you can use:
# 1. Create a free Neon DB account: https://neon.tech
# 2. Get a free Gemini API key: https://aistudio.google.com
# 3. Generate a random SECRET_KEY using: python -c "import secrets; print(secrets.token_urlsafe(32))"
